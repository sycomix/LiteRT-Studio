# LiteRT Studio — Docker environment variables
# Copy this file to .env and customize as needed

# Port for the Studio web interface (default: 7860)
PORT=7860

# Hugging Face token for downloading models (optional)
HF_TOKEN=hf_your_token_here

# Enable faster downloads via hf_transfer (requires hf_transfer package)
# Requires HF_TOKEN to be set
HF_HUB_ENABLE_HF_TRANSFER=0
