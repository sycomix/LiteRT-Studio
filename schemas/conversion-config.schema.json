{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litert-studio.dev/schemas/conversion-config.schema.json",
  "title": "LiteRT Studio conversion configuration",
  "type": "object",
  "required": ["schema_version", "kind", "source", "output"],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "conversion"},
    "name": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "output_format": {"enum": ["tflite", "litertlm"]},
    "quantization": {
      "enum": [
        "none",
        "dynamic_int8",
        "weight_only_int8",
        "dynamic_int4",
        "weight_only_int4",
        "static_int8"
      ]
    },
    "signatures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "representative_dataset": {"type": "string", "minLength": 1},
    "prefill_lengths": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "cache_length": {"type": "integer", "minimum": 1},
    "quantization_recipe": {"type": ["string", "null"]},
    "externalize_embedder": {"type": "boolean"},
    "use_jinja_template": {"type": "boolean"},
    "bundle_litert_lm": {"type": "boolean"},
    "operator_policy": {"type": "string", "minLength": 1},
    "atol": {"type": "number", "minimum": 0},
    "rtol": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
